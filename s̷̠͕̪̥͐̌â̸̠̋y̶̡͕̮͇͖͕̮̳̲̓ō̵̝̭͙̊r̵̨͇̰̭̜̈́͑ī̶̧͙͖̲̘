tabs.boss:AddSwitch("Auto Chest", function(state)
    tabs.boss.AutoChestData.Running = state
    
    if state then
        task.spawn(function()
            local lastBosses = {}
            
            while utils.isCurrent() and tabs.boss.AutoChestData.Running do
                pcall(function()
                    local char = lp.player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end

                    local currentBosses = {}
                    local deathPos = nil

                    for _, candidate in ipairs(services.CollectionService:GetTagged("BossEventBoss")) do
                        if candidate:IsA("Model") and candidate:IsDescendantOf(services.Workspace) then
                            local health, _, hitbox = tabs.boss.getBossData(candidate)
                            if hitbox and health and health > 0 then
                                currentBosses[candidate] = hitbox.Position
                            end
                        end
                    end
                    
                    for _, bossName in ipairs(halloweenBossNames) do
                        local candidate = services.Workspace:FindFirstChild(bossName)
                        if candidate and candidate:IsA("Model") then
                            local health, _, hitbox = tabs.boss.getBossData(candidate)
                            if hitbox and health and health > 0 then
                                currentBosses[candidate] = hitbox.Position
                            end
                        end
                    end

                    for oldBoss, oldPos in pairs(lastBosses) do
                        if not currentBosses[oldBoss] then
                            deathPos = oldPos
                            break
                        end
                    end
                    
                    lastBosses = currentBosses

                    if deathPos then
                        task.wait(1.5)
                        
                        local collected = false
                        for _, prompt in ipairs(services.Workspace:GetDescendants()) do
                            if prompt:IsA("ProximityPrompt") then
                                local pName = prompt.Name:lower()
                                local parentName = (prompt.Parent and prompt.Parent.Name:lower()) or ""
                                
                                if (pName:find("chest") or parentName:find("chest") or prompt.ActionText:lower():find("open")) then
                                    local dist = (prompt.Parent.Position - deathPos).Magnitude
                                    if dist <= 60 then
                                        hrp.CFrame = prompt.Parent.CFrame * CFrame.new(0, 3, 0)
                                        hrp.AssemblyLinearVelocity = Vector3.zero
                                        task.wait(0.2)
                                        
                                        if fireproximityprompt then
                                            fireproximityprompt(prompt, 1)
                                        else
                                            prompt.HoldDuration = 0
                                            prompt:InputHoldBegin()
                                            task.wait(0.1)
                                            prompt:InputHoldEnd()
                                        end
                                        collected = true
                                        task.wait(1)
                                    end
                                end
                            end
                        end
                        
                        if not collected then
                            hrp.CFrame = CFrame.new(deathPos) * CFrame.new(0, 2, 0)
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            task.wait(0.2)
                            for i = 1, 5 do
                                services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                                task.wait(0.1)
                                services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                                task.wait(0.2)
                            end
                        end
                    end
                end)
                task.wait(0.5)
            end
        end)
    end
end)

